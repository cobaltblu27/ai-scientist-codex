{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-scientist hooks codex-event SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-scientist hooks codex-event UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-scientist hooks codex-event Stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp",
        "hooks": [
          {
            "type": "command",
            "command": "ai-scientist hooks codex-event PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp",
        "hooks": [
          {
            "type": "command",
            "command": "ai-scientist hooks codex-event PostToolUse"
          }
        ]
      }
    ]
  }
}
