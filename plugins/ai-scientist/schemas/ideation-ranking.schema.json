{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ranked_ideas",
    "agent_notes"
  ],
  "properties": {
    "agent_notes": {
      "type": "string"
    },
    "ranked_ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evaluation",
          "score",
          "novelty_score",
          "feasibility_score",
          "evidence_score",
          "repo_fit_score",
          "rank",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "evaluation": {
            "enum": [
              "ACCEPTED",
              "ACCEPTED_WITHOUT_REFERENCE",
              "REJECTED"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "novelty_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "feasibility_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "repo_fit_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "rationale": {
            "type": "string"
          },
          "evidence_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "follow_up_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ranking_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
