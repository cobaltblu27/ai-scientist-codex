{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "checks",
    "evidence",
    "blockers"
  ],
  "properties": {
    "decision": {
      "enum": [
        "go",
        "no_go"
      ]
    },
    "checks": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    }
  }
}
