{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_type",
    "timestamp",
    "run_id",
    "details"
  ],
  "properties": {
    "event_type": {
      "description": "Compact v1 journal event category. One JSON object per journal.jsonl line.",
      "enum": [
        "state_transition",
        "api_call",
        "stop_hook",
        "resource_event",
        "subagent_event",
        "critic_event",
        "handoff",
        "validation",
        "selection",
        "setup",
        "dependency",
        "workspace",
        "note"
      ]
    },
    "timestamp": {
      "description": "UTC timestamp generated by the helper.",
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "transition_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "subagent_id": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "before_hash": {
      "type": "string"
    },
    "after_hash": {
      "type": "string"
    },
    "details": {
      "description": "Normalized helper payload. Large reasoning belongs in referenced artifacts, not new ledger files.",
      "type": "object"
    }
  },
  "additionalProperties": true
}
