{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "strictness_mode",
    "target_repo",
    "api_budgets",
    "workspace",
    "dependency_plan",
    "benchmark_contract"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "strictness_mode": {
      "enum": [
        "scientist",
        "researcher",
        "balanced",
        "builder",
        "engineer"
      ]
    },
    "target_repo": {
      "type": "string"
    },
    "benchmark": {
      "type": "string"
    },
    "split_policy": {
      "type": "string"
    },
    "api_budgets": {
      "description": "Per-service phase budgets such as semantic_scholar.max_calls.",
      "type": "object",
      "additionalProperties": true
    },
    "workspace": {
      "description": "Frozen workspace plan for copy/link behavior and baseline workspace path.",
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "copy",
            "copy_with_large_readonly_links"
          ]
        },
        "baseline_workspace": {
          "type": "string"
        },
        "large_readonly_links": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "dependency_plan": {
      "description": "Frozen dependency plan stored in config.json, replacing a separate dependency-plan.json for research v1.",
      "type": "object",
      "required": [
        "mode",
        "planned_dependencies"
      ],
      "properties": {
        "mode": {
          "enum": [
            "frozen",
            "yolo"
          ]
        },
        "planned_dependencies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "benchmark_contract": {
      "description": "Benchmark entrypoint contract used by baseline and node trials.",
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "metrics_schema": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "additionalProperties": true
    },
    "s2_enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
