{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "active",
    "phase",
    "phase_status",
    "updated_at",
    "stop_policy",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "phase": {
      "enum": [
        "ideation",
        "research",
        "review",
        "writeup"
      ]
    },
    "phase_status": {
      "enum": [
        "running",
        "verifying",
        "complete",
        "completed",
        "COMPLETED",
        "COMPLETED_BUDGET_EXHAUSTED",
        "cancelled",
        "CANCELLED",
        "blocked_on_user",
        "blocked_manual_recovery",
        "failed",
        "exhausted",
        "EXHAUSTED_NO_CANDIDATE"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "stop_policy": {
      "const": "block_until_completion_audit"
    },
    "completion_audit": {
      "type": [
        "object",
        "null"
      ]
    },
    "completed_phases": {
      "type": "object"
    },
    "state": {
      "description": "Phase-specific compact state. For research, this owns official node statuses, subagent ledger, resource ledger, selection pointer, and orchestrator cursor.",
      "type": "object",
      "properties": {
        "orchestrator": {
          "type": "object",
          "properties": {
            "next_action": {
              "type": "string"
            },
            "next_action_details": {
              "type": "object"
            },
            "current_node": {
              "type": "string"
            },
            "iteration": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "baseline_status": {
          "type": "string"
        },
        "nodes": {
          "type": "object"
        },
        "subagents": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "selected_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "last_transition_id": {
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
