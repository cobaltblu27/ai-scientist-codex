{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ideas"
  ],
  "properties": {
    "ideas": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "evaluation",
              "rank",
              "score",
              "upstream",
              "normalized",
              "source_run_id",
              "reflection_count",
              "literature_search_count"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "evaluation": {
                "enum": [
                  "ACCEPTED",
                  "ACCEPTED_WITHOUT_REFERENCE",
                  "REJECTED"
                ]
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "novelty_score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "feasibility_score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "evidence_score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "repo_fit_score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "upstream": {
                "type": "object"
              },
              "normalized": {
                "type": "object"
              },
              "source_run_id": {
                "type": "string"
              },
              "reflection_count": {
                "type": "integer",
                "minimum": 1
              },
              "literature_search_count": {
                "type": "integer",
                "minimum": 0
              },
              "manual_selection_only": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "hypothesis",
              "expected_metric",
              "risks"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "hypothesis": {
                "type": "string"
              },
              "expected_metric": {
                "type": "string"
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
