{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "phase",
    "status",
    "strictness_mode",
    "last_validation"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "strictness_mode": {
      "enum": [
        "scientist",
        "researcher",
        "balanced",
        "builder",
        "engineer"
      ]
    },
    "selected_node": {
      "type": "string"
    },
    "last_validation": {
      "type": "object"
    }
  }
}
