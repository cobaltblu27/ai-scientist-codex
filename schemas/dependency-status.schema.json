{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "planned_dependencies": {"$ref": "#/$defs/dependencies"},
    "statuses": {"$ref": "#/$defs/dependencies"}
  },
  "anyOf": [{"required": ["dependencies"]}, {"required": ["planned_dependencies"]}, {"required": ["statuses"]}],
  "$defs": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "decision": {"enum": ["approved", "blocked", "rejected", "not_needed"]},
          "status": {"enum": ["approved", "blocked", "rejected", "not_needed"]},
          "reason": {"type": "string"}
        },
        "anyOf": [{"required": ["decision"]}, {"required": ["status"]}]
      }
    }
  }
}
