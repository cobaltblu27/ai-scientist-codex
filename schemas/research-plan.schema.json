{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "strictness_mode", "metric_key", "metric_direction"],
  "properties": {
    "run_id": {"type": "string"},
    "idea_id": {"type": "string"},
    "strictness_mode": {"enum": ["scientist", "engineer", "custom"]},
    "metric_key": {"type": "string", "minLength": 1},
    "metric_direction": {"enum": ["maximize", "minimize"]},
    "success_threshold": {"type": "number"},
    "split_policy": {"type": "string"},
    "baseline_command": {"type": "string"},
    "required_deliverables": {"type": "array", "items": {"type": "string"}},
    "research_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "outcome_type": {
      "enum": [
        "hypothesis_supported",
        "hypothesis_failed_with_evidence",
        "rescue_finding_with_failed_hypothesis",
        "practical_improvement"
      ]
    }
  }
}
