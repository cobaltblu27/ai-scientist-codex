{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "gate",
    "decision",
    "reason"
  ],
  "properties": {
    "gate": {
      "const": "research_to_review"
    },
    "decision": {
      "enum": [
        "approved",
        "blocked",
        "rejected"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence_validation_command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "evidence_validation": {
      "type": "object"
    },
    "artifact_snapshot": {
      "type": [
        "string",
        "object"
      ]
    },
    "artifact_hash": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "final_validation_command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "validation": {
      "type": "object"
    },
    "decided_at": {
      "type": "string"
    }
  }
}
