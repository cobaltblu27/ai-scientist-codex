{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "action",
    "strictness_mode",
    "node_id",
    "template_id",
    "metadata"
  ],
  "properties": {
    "action": {
      "enum": [
        "draft",
        "debug",
        "improve",
        "tuning",
        "ablation"
      ]
    },
    "strictness_mode": {
      "enum": [
        "scientist",
        "researcher",
        "balanced",
        "builder",
        "engineer"
      ]
    },
    "node_id": {
      "type": "string"
    },
    "parent_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "template_id": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "idea": {
      "type": "object"
    },
    "metric_contract": {
      "type": "object",
      "required": [
        "metric_key",
        "metric_direction"
      ],
      "properties": {
        "metric_key": {
          "type": "string"
        },
        "metric_direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "success_threshold": {
          "type": "number"
        }
      }
    },
    "split_policy": {
      "type": "string"
    },
    "root_guidance_summary": {
      "type": "string"
    },
    "required_deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_manifest_schema_version": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "root_guidance": {
      "type": "object"
    },
    "manifest_only": {
      "type": "boolean"
    }
  }
}
