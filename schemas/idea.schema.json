{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ideas"],
  "properties": {
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family_key",
          "title",
          "hypothesis",
          "research_contract",
          "unique_protocol",
          "expected_metric",
          "smoke_runnable_now",
          "requires_implementation",
          "minimum_command",
          "evidence_refs",
          "rubric_scores",
          "risk_flags",
          "evaluation",
          "rank",
          "score",
          "source_run_id",
          "reflection_count",
          "literature_search_count"
        ],
        "properties": {
          "id": {"type": "string"},
          "family_key": {"type": "string"},
          "title": {"type": "string"},
          "hypothesis": {"type": "string"},
          "research_contract": {
            "type": "object",
            "properties": {
              "primary_hypothesis": {"type": "string"},
              "goal_type": {"type": "string"},
              "success_criteria": {},
              "failure_criteria": {},
              "allowed_rescue_scope": {},
              "kill_criteria": {},
              "non_drift_definition": {},
              "metrics_that_matter": {},
              "non_negotiable_comparisons": {},
              "baseline_reference": {"type": "object"},
              "benchmark_plan": {},
              "target_threshold": {}
            },
            "additionalProperties": true
          },
          "unique_protocol": {"type": "string"},
          "expected_metric": {"type": "string"},
          "smoke_runnable_now": {"type": "boolean"},
          "requires_implementation": {"type": "array", "items": {"type": "string"}},
          "minimum_command": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "rubric_scores": {"type": "object"},
          "risk_flags": {"type": "array", "items": {"type": "string"}},
          "evaluation": {"enum": ["ACCEPTED", "ACCEPTED_WITHOUT_REFERENCE", "REJECTED"]},
          "rank": {"type": ["integer", "null"], "minimum": 1},
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "source_run_id": {"type": "string"},
          "reflection_count": {"type": "integer", "minimum": 1},
          "literature_search_count": {"type": "integer", "minimum": 0},
          "manual_selection_only": {"type": "boolean"},
          "normalized": {"type": "object"},
          "upstream": {"type": "object"},
          "draft_ref": {"type": ["string", "null"]},
          "critic_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
