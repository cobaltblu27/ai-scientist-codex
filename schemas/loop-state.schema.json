{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop-state.json (docs/SCHEMA.md section 3.3)",
  "type": "object",
  "required": ["run_id", "phase", "phase_status", "active", "updated_at", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "phase": {"enum": ["research", "review", "writeup"]},
    "phase_status": {"enum": ["running", "success", "exhausted", "cancelled", "blocked", "complete"]},
    "active": {"type": "boolean"},
    "updated_at": {"type": "string"},
    "last_transition_id": {"type": ["string", "null"]},
    "run_outcome": {"type": ["string", "null"]},
    "blocked_reason": {"type": ["string", "null"]},
    "links": {"type": "object"},
    "state": {
      "type": "object",
      "properties": {
        "orchestrator": {
          "type": "object",
          "required": ["next_action"],
          "properties": {"next_action": {"type": "string"}},
          "additionalProperties": true
        },
        "baseline": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"type": "string"}},
          "additionalProperties": true
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "updated_at"],
            "properties": {
              "status": {"type": "string"},
              "updated_at": {"type": "string"},
              "parent_node_id": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "agent_thread_id", "result_ref", "node"],
            "properties": {
              "status": {"type": "string"},
              "agent_thread_id": {"type": "string"},
              "result_ref": {"type": "string"},
              "node": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "tasks": {"type": "object"},
        "resources": {"type": "object"},
        "resource_queue": {"type": "object"},
        "selection": {
          "type": "object",
          "required": ["status", "selected_node"],
          "properties": {
            "status": {"enum": ["pending", "final"]},
            "selected_node": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
