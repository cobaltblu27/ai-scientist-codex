{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "node_id",
    "status",
    "benchmark_contract_version",
    "split_integrity",
    "leakage_check",
    "result_summary",
    "mode_deliverables",
    "trials"
  ],
  "properties": {
    "node_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "implementing",
        "running",
        "buggy",
        "repairing",
        "candidate",
        "validating",
        "accepted",
        "invalid",
        "rejected"
      ]
    },
    "benchmark_contract_version": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "metrics_ref": {
      "type": "string"
    },
    "split_integrity": {
      "type": "object",
      "required": [
        "pass"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "leakage_check": {
      "type": "object",
      "required": [
        "pass"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "novelty": {
      "description": "Required to pass for accepted scientist nodes.",
      "type": "object",
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "result_summary": {
      "type": "string"
    },
    "mode_deliverables": {
      "type": "object"
    },
    "outcome_type": {
      "enum": [
        "hypothesis_supported",
        "hypothesis_failed_with_evidence",
        "rescue_finding_with_failed_hypothesis",
        "practical_improvement"
      ]
    },
    "current_claim": {
      "type": "string"
    },
    "claim_equivalence": {
      "type": "object",
      "additionalProperties": true
    },
    "contract_evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "fundamental_failure_reason": {
      "type": "string"
    },
    "paper_worthiness": {
      "type": "object",
      "additionalProperties": true
    },
    "strong_model_evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "critic_reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "requires_worker_repair": {
      "type": "boolean"
    },
    "open_repair_id": {
      "type": "string"
    },
    "last_repair_id": {
      "type": "string"
    },
    "worker_recommendation": {
      "type": "string"
    },
    "failure_signature": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "trials": {
      "description": "Flat list of command trials, not grouped by purpose.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trial_id",
          "purpose",
          "status",
          "benchmark_contract_version"
        ],
        "properties": {
          "trial_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "command_ref": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          },
          "metrics_ref": {
            "type": "string"
          },
          "resource_lease_id": {
            "type": "string"
          },
          "seed": {
            "type": "string"
          },
          "benchmark_contract_version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "metrics"
      ]
    },
    {
      "required": [
        "metrics_ref"
      ]
    }
  ],
  "additionalProperties": true
}
