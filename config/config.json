{
  "schema_version": 1,
  "evidence_paper_scoring": {
    "citation_max": 40,
    "citation_log_weight": 8,
    "recency_max": 30,
    "recency_decay_per_year": 3,
    "venue_max": 30,
    "impact_factor_multiplier": 2,
    "unknown_venue_score": 2
  },
  "ranking": {
    "max_evidence_papers_per_idea": 10
  },
  "ideation": {
    "default_mode": "scientist",
    "num_ideas_required": 10,
    "min_candidates_required": 1,
    "reflection_budget": 120,
    "early_stop_allowed": false,
    "prompt_root": "prompts/ideation",
    "concurrency": {
      "max_subagents": 6
    },
    "modes": {
      "scientist": {
        "s2_required": true,
        "allow_accepted_without_reference": false,
        "allow_selection_without_reference": false,
        "candidate_evaluations": [
          "ACCEPTED"
        ],
        "scoring_weights": {
          "novelty": 0.35,
          "evidence": 0.25,
          "feasibility": 0.2,
          "repo_fit": 0.2
        },
        "generator_prompt": "prompts/ideation/scientist/generator.md",
        "critic_prompt": "prompts/ideation/scientist/critic.md",
        "ranker_prompt": "prompts/ideation/scientist/ranker.md"
      },
      "engineer": {
        "s2_required": false,
        "allow_accepted_without_reference": true,
        "allow_selection_without_reference": true,
        "candidate_evaluations": [
          "ACCEPTED",
          "ACCEPTED_WITHOUT_REFERENCE"
        ],
        "scoring_weights": {
          "performance": 0.45,
          "feasibility": 0.3,
          "repo_fit": 0.2,
          "novelty": 0.05
        },
        "generator_prompt": "prompts/ideation/engineer/generator.md",
        "critic_prompt": "prompts/ideation/engineer/critic.md",
        "ranker_prompt": "prompts/ideation/engineer/ranker.md"
      },
      "custom": {
        "s2_required": false,
        "allow_accepted_without_reference": true,
        "allow_selection_without_reference": true,
        "candidate_evaluations": [
          "ACCEPTED",
          "ACCEPTED_WITHOUT_REFERENCE"
        ],
        "scoring_weights": {
          "custom_fit": 0.4,
          "feasibility": 0.3,
          "repo_fit": 0.2,
          "evidence": 0.1
        },
        "generator_prompt": "prompts/ideation/custom/generator.md",
        "critic_prompt": "prompts/ideation/custom/critic.md",
        "ranker_prompt": "prompts/ideation/custom/ranker.md"
      }
    }
  },
  "research": {
    "concurrency": {
      "max_subagents": 6
    },
    "usage_cap": {
      "enabled": true,
      "warning_threshold_percent": 85,
      "cap_threshold_percent": 95,
      "poll_interval_seconds": 600,
      "limit_id": "codex",
      "source": "codex app-server account/rateLimits/read",
      "no_limit_host_cap": false
    },
    "modes": {
      "scientist": {
        "node_critic_prompt_template": "You are an independent research-node critic in scientist mode. Review node {node_id} for novelty, evidence, ablations, leakage/split integrity, reproducibility, and publishability. Partial success, promising progress, or evidence needing validation must be REVISE/candidate, not ACCEPT."
      },
      "researcher": {
        "node_critic_prompt_template": "You are an independent research-node critic in researcher mode. Review node {node_id} for research usefulness, evidence quality, ablations, leakage/split integrity, reproducibility, and publishability. Partial success, promising progress, or evidence needing validation must be REVISE/candidate, not ACCEPT."
      },
      "balanced": {
        "node_critic_prompt_template": "You are an independent research-node critic in balanced mode. Review node {node_id} for benchmark integrity, evidence, implementation quality, leakage/split integrity, reproducibility, practical value, and risk. Partial success, promising progress, or evidence needing validation must be REVISE/candidate, not ACCEPT."
      },
      "engineer": {
        "node_critic_prompt_template": "You are an independent research-node critic in engineer mode. Review node {node_id} for benchmark integrity, implementation quality, performance, maintainability, reproducibility, and risk. Partial success, promising progress, or evidence needing validation must be REVISE/candidate, not ACCEPT."
      },
      "builder": {
        "node_critic_prompt_template": "You are an independent research-node critic in builder mode. Review node {node_id} for benchmark integrity, implementation quality, performance, maintainability, reproducibility, buildability, and risk. Partial success, promising progress, or evidence needing validation must be REVISE/candidate, not ACCEPT."
      }
    }
  },
  "venue_impact": {
    "aliases": {
      "aaai": "aaai",
      "association for the advancement of artificial intelligence": "aaai",
      "acl": "acl",
      "annual meeting of the association for computational linguistics": "acl",
      "cvpr": "cvpr",
      "computer vision and pattern recognition": "cvpr",
      "emnlp": "emnlp",
      "empirical methods in natural language processing": "emnlp",
      "iclr": "iclr",
      "international conference on learning representations": "iclr",
      "icml": "icml",
      "international conference on machine learning": "icml",
      "ijcai": "ijcai",
      "international joint conference on artificial intelligence": "ijcai",
      "nature": "nature",
      "neurips": "neurips",
      "neural information processing systems": "neurips",
      "nips": "neurips",
      "pnas": "pnas",
      "proceedings of the national academy of sciences": "pnas",
      "science": "science",
      "uai": "uai",
      "uncertainty in artificial intelligence": "uai"
    },
    "venues": {
      "aaai": {
        "display_name": "AAAI",
        "impact_factor": 5
      },
      "acl": {
        "display_name": "ACL",
        "impact_factor": 6
      },
      "cvpr": {
        "display_name": "CVPR",
        "impact_factor": 8
      },
      "emnlp": {
        "display_name": "EMNLP",
        "impact_factor": 6
      },
      "iclr": {
        "display_name": "ICLR",
        "impact_factor": 8
      },
      "icml": {
        "display_name": "ICML",
        "impact_factor": 8
      },
      "ijcai": {
        "display_name": "IJCAI",
        "impact_factor": 5
      },
      "nature": {
        "display_name": "Nature",
        "impact_factor": 50
      },
      "neurips": {
        "display_name": "NeurIPS",
        "impact_factor": 8
      },
      "pnas": {
